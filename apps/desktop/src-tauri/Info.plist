<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Tauri 2 merges this file into the generated macOS bundle Info.plist.
      The operator console talks to the LAN meeting server over HTTPS at an
      RFC1918 IP (default wss://192.168.0.38) whose TLS cert is signed by a
      private Caddy local CA. App Transport Security pre-flight-refuses that
      connection in the bundled .app (fails in <30ms, before the socket opens)
      even though the system trust store accepts the cert. NSAllowsLocalNetworking
      relaxes ATS for local/private/loopback/link-local addresses only — public
      internet domains keep full ATS enforcement. Broader than this (e.g.
      NSAllowsArbitraryLoads) is unnecessary for a LAN-only server.
    -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
