{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yeson-meet",
  "version": "1.3.9",
  "identifier": "com.yeson.meet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build:vite"
  },
  "app": {
    "windows": [
      {
        "title": "yeson-meet",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Business",
    "shortDescription": "yeson-meet meeting room client",
    "longDescription": "Desktop client for starting yeson-meet meeting room caption sidecars.",
    "macOS": {
      "minimumSystemVersion": "14.2"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBMjZBNzU2OTJBNTUzQzQKUldURVU2V1NWcWNtYWlHMzdJMm9UMzU3OTNUNEV3d2xRbEVHRU1HMUN5d3ZGN0hlQVAzRmJXTC8K",
      "endpoints": [
        "https://github.com/yesonsys03-web/yeson_meet/releases/latest/download/latest-client.json"
      ]
    }
  }
}
