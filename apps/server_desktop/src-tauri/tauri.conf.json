{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yeson-server-console",
  "version": "1.7.5",
  "identifier": "com.yeson.server-console",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5274",
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build:vite"
  },
  "app": {
    "windows": [
      {
        "title": "yeson server console",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Business",
    "shortDescription": "yeson-meet server operator console",
    "longDescription": "Desktop console that runs and supervises the packaged yeson-meet server.",
    "resources": [
      "binaries/yeson-server-*/**/*",
      "binaries/cloudflared-*/**/*",
      "binaries/ffmpeg-*/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBMjZBNzU2OTJBNTUzQzQKUldURVU2V1NWcWNtYWlHMzdJMm9UMzU3OTNUNEV3d2xRbEVHRU1HMUN5d3ZGN0hlQVAzRmJXTC8K",
      "endpoints": [
        "https://github.com/yesonsys03-web/yeson_meet/releases/latest/download/latest-server.json"
      ]
    }
  }
}
