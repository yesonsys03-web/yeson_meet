# Secrets
.env
.env.*
!.env.example

# Logs (may contain JWT / Device API Key in WS URLs — see server-latency.log incident)
*.log
!tests/**/fixtures/*.log

# Node
node_modules/
dist/
.vite/

# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Rust / Tauri
target/
apps/desktop/src-tauri/binaries/
apps/server_desktop/src-tauri/binaries/yeson-server-*/
apps/server_desktop/src-tauri/binaries/cloudflared-*/
apps/server_desktop/src-tauri/binaries/ffmpeg-*/

# Compose volumes
deploy/data/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# VibeLign
.vibelign/checkpoints/
.vibelign/rust_checkpoints/
.vibelign/rust_objects/
.vibelign/scan_cache.json
.vibelign/logs/
.vibelign/reports/
.vibelign/*.db-shm
.vibelign/*.db-wal

# Tool state (entire directories — heavy / per-machine)
.vibelign/cache/
.vibelign/docs_html/
.vibelign/docs_visual/
.vibelign/memory_audit.jsonl
.vibelign/*.json
.vibelign/*.db
.omc/sessions/
.omc/state/
.omc/logs/
.omc/project-memory.json
**/.omc/

# Build artifacts that should never be committed
*.exe

# Generated build artifacts (markdown card HTML, etc.)
generated/

# Tauri build output (extra safety)
apps/desktop/src-tauri/gen/
apps/server_desktop/src-tauri/gen/
