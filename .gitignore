.vibelign/docs_visual/
.vibelign/memory_audit.jsonl
.vibelign/*.json
.vibelign/*.db
.omc/sessions/
.omc/state/
.omc/logs/
.omc/project-memory.json
**/.omc/

# superpowers SDD scratch dir (task briefs/reports/reviews) — never commit
.superpowers/

# Build artifacts that should never be committed
*.exe

# Generated build artifacts (markdown card HTML, etc.)
generated/

# Tauri build output (extra safety)
apps/desktop/src-tauri/gen/
apps/server_desktop/src-tauri/gen/

# 스파이크 스크래치 (커밋 금지)
