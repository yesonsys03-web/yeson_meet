# Secrets
.env
.env.*
!.env.example

# Logs (may contain JWT / Device API Key in WS URLs — see server-latency.log incident)
*.log
!tests/**/fixtures/*.log

# Node
node_modules/
dist/
.vite/

# repo uses pnpm workspaces — a stray bun.lock has been mistakenly committed
# twice already; keep it untracked (the file itself may stay on disk).
bun.lock

# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Rust / Tauri
target/
apps/desktop/src-tauri/binaries/
apps/server_desktop/src-tauri/binaries/yeson-server-*/
apps/server_desktop/src-tauri/binaries/cloudflared-*/
apps/server_desktop/src-tauri/binaries/ffmpeg-*/
apps/server_desktop/src-tauri/binaries/apple-translate-*/

# Compose volumes
deploy/data/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# VibeLign
.vibelign/checkpoints/
.vibelign/rust_checkpoints/
.vibelign/rust_objects/
.vibelign/scan_cache.json
.vibelign/logs/
.vibelign/reports/
