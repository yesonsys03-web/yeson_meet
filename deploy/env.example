# yeson-meet environment (copy to .env at repo root or deploy/)
# 절대 실제 키를 커밋하지 마라. 모두 replace-me.

# Network access mode: lan | tunnel | localhost
ACCESS_MODE=lan

# Server FQDN or IP used by Caddy. For local dev: localhost
SERVER_HOST=localhost

# Public base URL used to build the participant viewer QR (viewer_url = VIEWER_BASE/v/<token>).
# LAN mode: set to your server's HTTPS address, e.g. https://192.168.0.38
# Tunnel mode: leave as-is; deploy/tunnel-quick.sh auto-sets it to the trycloudflare URL.
VIEWER_BASE=https://localhost

# Postgres
DB_USER=yeson
DB_PASSWORD=replace-me-strong-password  # vibelign: allow-secret
DB_NAME=yeson_meet

# FastAPI JWT (HS256). 32-byte URL-safe random base64 recommended.
JWT_SECRET=replace-me-with-openssl-rand-base64-32  # vibelign: allow-secret

# Gemini Live API key — 서버 환경변수에만 (회의실 PC에 배포 X).
# S3까지는 비워둬도 server boot OK. S3 진입 시 실키 주입.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_FAST_PARTIAL_TRANSLATION_ENABLED=1
GEMINI_PARTIAL_TRANSLATION_MODEL=gemini-2.5-flash-lite
GEMINI_PARTIAL_MIN_CHARS=12
GEMINI_PARTIAL_MIN_WORDS=2
GEMINI_PARTIAL_MIN_DELTA_CHARS=6
GEMINI_PARTIAL_FORCE_CHARS=90
GEMINI_PARTIAL_TRANSLATION_TIMEOUT_MS=2000
GEMINI_EXPLICIT_VAD_ENABLED=0
GEMINI_EXPLICIT_VAD_RMS_DBFS_THRESHOLD=-50
GEMINI_EXPLICIT_VAD_END_SILENCE_MS=320
GEMINI_EXPLICIT_VAD_MAX_SPEECH_MS=2500
# 자발적 세션 cycle 주기 (soft target). Gemini Live의 자연 세션 한도
# (1008 GoAway)에 도달하기 전에 우리가 먼저 깔끔하게 재접속한다.
GEMINI_SEGMENT_MAX_SPEECH_MS=120000
# 절대 backstop. 무한정 말해도 이 시간 안에는 cycle 강제.
GEMINI_SEGMENT_HARD_MAX_SPEECH_MS=300000
# soft target 이후 이 시간만큼 침묵이 감지되어야 cycle. 발화 중간 cut을
# 피해 backlog flush 갭(7-28초)을 줄인다.
GEMINI_SEGMENT_CYCLE_SILENCE_MS=400
# Speech가 보내졌는데도 input/output transcription이 안 오면 이 시간 후 force-cycle.
# Gemini가 내부 batching/stuck인 케이스 회피.
GEMINI_SEGMENT_STUCK_WATCHDOG_MS=45000

# AI provider: gemini_live | google_stt_translate
# google_stt_translate uses Speech-to-Text streaming interim transcripts plus
# Cloud Translation for lower-latency partial Korean subtitles.
YESON_AI_PROVIDER=gemini_live
GOOGLE_CLOUD_PROJECT=
GOOGLE_STT_LANGUAGE_CODE=en-US
GOOGLE_TRANSLATE_TARGET_LANGUAGE=ko
GOOGLE_TRANSLATE_LOCATION=global

# Local Docker auth option for google_stt_translate.
# Paste a one-line service-account JSON only in your private .env, never commit it.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Storage volume root inside container (do not change unless you also update compose)
STORAGE_ROOT=/var/lib/yeson-meet/storage
